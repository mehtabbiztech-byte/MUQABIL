# ==============================================================================
# MEQSA Study Platform - Environment Variables
# ==============================================================================
# - Core application features (MCQs, quizzes, past papers, jobs, current affairs,
#   bookmarks, mistakes notebook) run cleanly without requiring external AI APIs.
# ==============================================================================

# [OPTIONAL] Production Application URL
# Set this to your live domain (e.g. https://muqabil-test.vercel.app).
APP_URL="https://muqabil-test.vercel.app"
VITE_APP_URL="https://muqabil-test.vercel.app"

# [OPTIONAL] Google Analytics Measurement ID (GA4)
# If you want to track aspirant traffic and test completions (e.g. G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=""

# [OPTIONAL] Gemini API Key for server-side AI chatbot & tutoring
GEMINI_API_KEY=

