{
  "name": "muqabil",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehtabbiztech-byte/MUQABIL.git"
  },
  "homepage": "https://github.com/mehtabbiztech-byte/MUQABIL",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "generate:docs": "tsx scripts/generate-technical-pdf.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "validate:sts": "esbuild scripts/validate-sts-bank.ts --bundle --platform=node --format=esm --outfile=/tmp/meqsa-sts-bank-validation.mjs && node /tmp/meqsa-sts-bank-validation.mjs",
    "validate:current-affairs": "esbuild scripts/validate-current-affairs-bank.ts --bundle --platform=node --format=esm --outfile=/tmp/meqsa-current-affairs-validation.mjs && node /tmp/meqsa-current-affairs-validation.mjs"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@google/genai@2.22.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3"
  }
}