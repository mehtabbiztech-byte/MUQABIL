rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isPublicContent() {
      return resource.data.status == 'Published'
        && (!('publishAtEpoch' in resource.data) || resource.data.publishAtEpoch == 0 || resource.data.publishAtEpoch <= request.time.toMillis());
    }

    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /cms_mcqs/{contentId} {
      allow read: if isAdmin() || isPublicContent();
      allow create, update, delete: if isAdmin();
    }

    match /cms_past_papers/{contentId} {
      allow read: if isAdmin() || isPublicContent();
      allow create, update, delete: if isAdmin();
    }

    match /cms_lessons/{contentId} {
      allow read: if isAdmin() || isPublicContent();
      allow create, update, delete: if isAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // User Profile Document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'targetExam', 'province', 'bookmarks', 'mistakes',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.targetExam is string
        && request.resource.data.province is string
        && request.resource.data.bookmarks is list
        && request.resource.data.mistakes is list
        && request.resource.data.bookmarks.size() <= 2000
        && request.resource.data.mistakes.size() <= 2000;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'targetExam', 'province', 'bookmarks', 'mistakes',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.targetExam is string
        && request.resource.data.province is string
        && request.resource.data.bookmarks is list
        && request.resource.data.mistakes is list
        && request.resource.data.bookmarks.size() <= 2000
        && request.resource.data.mistakes.size() <= 2000;
      allow delete: if isOwner(userId);

      // Quiz History Subcollection with Backend Validation
      match /quiz_history/{quizId} {
        allow read: if isOwner(userId);
        
        // Backend validation: reject impossible quiz scores
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.score is number
          && request.resource.data.totalQuestions is number
          && request.resource.data.totalQuestions > 0
          && request.resource.data.score >= 0
          && request.resource.data.score <= request.resource.data.totalQuestions
          && request.resource.data.percentage is number
          && request.resource.data.percentage >= 0
          && request.resource.data.percentage <= 100
          && request.resource.data.timeSpentSeconds is number
          && request.resource.data.timeSpentSeconds >= 0
          && request.resource.data.keys().hasOnly([
            'id', 'userId', 'quizTitle', 'category', 'score',
            'totalQuestions', 'percentage', 'timeSpentSeconds', 'passed',
            'date', 'createdAt', 'incorrectCount', 'certificateId', 'rankTier'
          ]);

        // Quiz submissions are immutable historical logs
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Private study plans are explicitly opt-in synced and scoped to the owner.
      match /study_plans/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['userId', 'plan', 'updatedAt'])
          && request.resource.data.userId == userId
          && request.resource.data.updatedAt is string
          && request.resource.data.plan is map
          && request.resource.data.plan.id == planId
          && request.resource.data.plan.keys().hasOnly([
            'id', 'generatedAt', 'updatedAt', 'startDate', 'form',
            'completedTaskIds', 'completedTaskDates', 'completedTopicIds',
            'completedSubtopicIds', 'plannedTopicIds', 'mockAttempts',
            'aiPersonalizationRequested', 'aiPlanStatus', 'aiPlanAdvice'
          ])
          && request.resource.data.plan.form is map
          && request.resource.data.plan.form.keys().hasOnly([
            'organizationId', 'positionId', 'customPosition', 'subjectSlugs',
            'preparationMode', 'currentLevel', 'examDate', 'dailyStudyMinutes',
            'targetScore', 'weakAreas'
          ])
          && request.resource.data.plan.form.subjectSlugs is list
          && request.resource.data.plan.form.subjectSlugs.size() <= 60
          && request.resource.data.plan.form.weakAreas is list
          && request.resource.data.plan.form.weakAreas.size() <= 30
          && request.resource.data.plan.completedTaskIds is list
          && request.resource.data.plan.completedTaskIds.size() <= 10000
          && request.resource.data.plan.completedSubtopicIds is list
          && request.resource.data.plan.completedSubtopicIds.size() <= 10000
          && request.resource.data.plan.mockAttempts is list
          && request.resource.data.plan.mockAttempts.size() <= 500
          && (!('completedTaskDates' in request.resource.data.plan)
            || (request.resource.data.plan.completedTaskDates is map
              && request.resource.data.plan.completedTaskDates.keys().size() <= 10000));
        allow delete: if isOwner(userId);
      }
    }
  }
}
